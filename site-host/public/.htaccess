# Apache / LiteSpeed rules for the static site (Hostinger copies this into public_html).
# site-host/server.mjs applies the same rules when the site is served locally.

AddType text/markdown .md
AddDefaultCharset UTF-8
AddCharset UTF-8 .txt .md .xml

# Agents that send "Accept: text/markdown" get the Markdown version of a page, where one exists.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteCond %{REQUEST_URI} ^(.*/)(index\.html)?$
  RewriteCond %{DOCUMENT_ROOT}%1index.md -f
  RewriteRule ^ %1index.md [L]
</IfModule>

# RFC 8288 Link header pointing agents at the site summary.
# Kept free of quotes: Hostinger's server sends escaped quotes literally.
<IfModule mod_headers.c>
  Header always set Link "</llms.txt>; rel=describedby"
  <FilesMatch "\.(html|md)$">
    Header merge Vary Accept
  </FilesMatch>
</IfModule>
